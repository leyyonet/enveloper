{
  "name": "@leyyo/enveloper",
  "version": "1.3.4",
  "description": "Error enveloper",
  "keywords": [
    "error propagate",
    "error swallow",
    "error ignore"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leyyonet/enveloper.git"
  },
  "bugs": {
    "email": "mustafayelmer@gmail.com",
    "url": "https://github.com/leyyonet/enveloper.git/issues"
  },
  "homepage": "https://github.com/leyyonet/enveloper.git/#readme",
  "author": {
    "name": "Mustafa Yelmer",
    "email": "mustafayelmer@gmail.com"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clear": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "asset": "node -r ts-node/register commands/assets.js",
    "build": "npm run clear && tsc && npm run asset",
    "test": "jest --config=jest.json",
    "test:watch": "jest --watch --config=jest.json",
    "test:coverage": "jest --config=jest.json --coverage --coverageDirectory=coverage",
    "~publish": "npm run build && npm publish -access=public"
  },
  "files": [
    "dist/*"
  ],
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "@types/jest": "^29.2.5",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.3.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@leyyo/builder": "^3.1.10",
    "@leyyo/common": "^1.3.9",
    "@leyyo/either": "^1.3.3"
  }
}
